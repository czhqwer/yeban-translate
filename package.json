{
  "name": "yeban-translate",
  "version": "0.4.4",
  "private": true,
  "type": "module",
  "description": "页伴翻译：网页双语与点击划词翻译",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
