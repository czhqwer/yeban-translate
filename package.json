    "check": "npm run typecheck && npm run test && npm run build",
    "pack:extension": "node scripts/pack.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.4.1",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
